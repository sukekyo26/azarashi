{
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showCustom": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.copilot/statusline.sh"
  },
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash",
        "bash": "node \"$HOME/.agents/hooks/route-command-output.mjs\" --client=copilot",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "for d in 0 0.3 0.6 0.9 1.2; do (sleep \"$d\"; printf '\\a' > /dev/tty) & done; wait",
        "timeoutSec": 10
      }
    ]
  }
}
