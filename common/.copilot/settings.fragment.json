{
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showCustom": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.copilot/statusline.sh"
  },
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash",
        "bash": "node \"$HOME/.copilot/hooks/route-command-output.mjs\"",
        "timeoutSec": 5
      }
    ]
  }
}
