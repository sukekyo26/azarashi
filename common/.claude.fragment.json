{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false",
        "--add-mode",
        "no-memories",
        "--add-mode",
        "claude-code-tools"
      ],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      },
      "alwaysLoad": true
    }
  }
}
