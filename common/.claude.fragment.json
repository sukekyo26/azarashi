{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v1.7.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code"
      ],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      }
    }
  }
}
