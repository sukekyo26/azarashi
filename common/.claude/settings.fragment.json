{
  "language": "japanese",
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "outputStyle": "Serena",
  "permissions": {
    "allow": [
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "Bash(rtk git blame *)",
      "Bash(rtk git fetch *)",
      "Bash(rtk git stash list)",
      "Bash(rtk git branch)",
      "Bash(rtk git branch -a)",
      "Bash(rtk git branch -vv)",
      "Bash(rtk git commit *)",
      "Bash(rtk ls *)",
      "Bash(rtk read *)",
      "Bash(rtk grep *)",
      "Bash(rtk tree *)",
      "Bash(rtk wc *)",
      "Bash(rtk du *)",
      "Bash(rtk jq *)",
      "Bash(rtk shellcheck *)",
      "Bash(shfmt -d *)",
      "Bash(shfmt -l *)",
      "Bash(ast-grep *)",
      "Bash(command -v *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rtk git push *)",
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh repo delete *)",
      "Bash(rtk git checkout -- *)",
      "Bash(rtk git branch -D *)",
      "Bash(rtk git stash drop *)"
    ],
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/credentials)"
    ]
  },
  "showTurnDuration": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/warn-cold-cache-cost.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/hooks/route-command-output.mjs\" --client=claude-code" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks remind --client=claude-code" }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          { "type": "command", "command": "serena-hooks auto-approve --client=claude-code" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks activate --client=claude-code" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks cleanup --client=claude-code" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "sleep 0;   printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.3; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.6; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.9; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 1.2; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" }
        ]
      }
    ]
  },
  "autoInstallIdeExtension": false
}
