{
  "language": "japanese",
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "outputStyle": "Serena",
  "permissions": {
    "allow": [
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "Bash(rtk git blame *)",
      "Bash(rtk git fetch *)",
      "Bash(rtk git stash list)",
      "Bash(rtk git branch)",
      "Bash(rtk git branch -a)",
      "Bash(rtk git branch -vv)",
      "Bash(rtk git commit *)",
      "Bash(rtk git push *)",
      "Bash(git push *)",
      "Bash(rtk git worktree list)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk stat *)",
      "Bash(rtk diff *)",
      "Bash(rtk ls *)",
      "Bash(rtk read *)",
      "Bash(rtk grep *)",
      "Bash(rtk tree *)",
      "Bash(rtk wc *)",
      "Bash(rtk du *)",
      "Bash(rtk jq *)",
      "Bash(rtk shellcheck *)",
      "Bash(shfmt -d *)",
      "Bash(shfmt -l *)",
      "Bash(ast-grep *)",
      "Bash(command -v *)",
      "Bash(rtk recall *)",
      "Bash(rtk rewrite *)",
      "Bash(rtk --version)",
      "Bash(rtk go build *)",
      "Bash(rtk go test *)",
      "Bash(rtk go vet *)",
      "Bash(rtk golangci-lint *)",
      "Bash(rtk cargo build *)",
      "Bash(rtk cargo test *)",
      "Bash(rtk cargo check *)",
      "Bash(rtk cargo clippy *)",
      "Bash(rtk pytest *)",
      "Bash(uv run rtk pytest *)",
      "Bash(rtk ruff check *)",
      "Bash(rtk mypy *)",
      "Bash(pyright *)",
      "Bash(rtk tsc *)",
      "Bash(gitleaks detect *)",
      "Bash(rtk docker ps *)",
      "Bash(rtk docker compose ps *)",
      "Bash(rtk docker logs *)",
      "Bash(rtk docker images *)",
      "Bash(rtk aws sts get-caller-identity)",
      "Bash(rtk aws s3 ls *)",
      "Bash(rtk tofu plan *)",
      "Bash(rtk tofu validate *)"
    ],
    "ask": [
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh repo delete *)",
      "Bash(rtk git checkout -- *)",
      "Bash(rtk git branch -D *)",
      "Bash(rtk git stash drop *)"
    ],
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/credentials)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/credentials*)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.import_linter_cache/**)",
      "Read(./**/.hypothesis/**)",
      "Read(./**/.tox/**)",
      "Read(./**/.nox/**)",
      "Read(./**/*.egg-info/**)",
      "Read(./**/htmlcov/**)",
      "Read(./**/.coverage)",
      "Read(./**/target/**)",
      "Read(./**/.next/**)",
      "Read(./**/.nuxt/**)",
      "Read(./**/.svelte-kit/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.parcel-cache/**)",
      "Read(./**/.vite/**)",
      "Read(./**/.eslintcache)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./**/coverage/**)",
      "Read(./**/.nyc_output/**)",
      "Read(./**/.cache/**)"
    ]
  },
  "showTurnDuration": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/warn-cold-cache-cost.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/hooks/route-command-output.mjs\" --client=claude-code" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks remind --client=claude-code" }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          { "type": "command", "command": "serena-hooks auto-approve --client=claude-code" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks activate --client=claude-code" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks cleanup --client=claude-code" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "sleep 0;   printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.3; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.6; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 0.9; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" },
          { "type": "command", "command": "sleep 1.2; printf '%s' '{\"terminalSequence\": \"\\u0007\"}'" }
        ]
      }
    ]
  },
  "autoInstallIdeExtension": false
}
