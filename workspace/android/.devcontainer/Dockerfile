COCOON_PLUGIN_EOF
# Install Terraform
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    RC_FILE="$HOME/.zshrc" RC_SYNTAX="posix" LOGIN_SHELL="zsh" COCOON_INSTALL_METHOD="binary" PIN="1.16.3" bash <<'COCOON_PLUGIN_EOF'
#!/usr/bin/env bash
# Install Terraform (https://github.com/hashicorp/terraform)
#
# Integrity: the SHA256SUMS manifest is verified with gpg against HashiCorp's
# release signing key (bundled below) before the downloaded zip is checked
# against it. The key ships with cocoon — a different trust domain than
# releases.hashicorp.com — so a poisoned CDN cannot supply both a malicious
# zip and a matching signature. This plugin declares verify = "pgp": it takes
# no per-workspace CHECKSUM_*, and signature verification covers every version
# (pinned or latest) without per-release checksum maintenance.
#
# Key maintenance: the bundled key is HashiCorp Security
# <security@hashicorp.com>, primary fingerprint
# C874 011F 0AB4 0511 0D02 1055 3436 5D94 72D7 468F. An expired key still
# verifies past signatures (gpg exits 0); only an actual key replacement
# breaks installs. If HashiCorp rotates the key, refresh the block below from
# https://www.hashicorp.com/.well-known/pgp-key.txt and update the
# fingerprint check.
#
# Inputs (env):
#   PIN : Terraform version without leading "v" (e.g. "1.10.5"); empty = latest
set -euo pipefail

ARCH="$(dpkg --print-architecture)"

if [ -n "$PIN" ]; then
  VERSION="$PIN"
else
  VERSION=$(curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 --retry-all-errors \
    https://checkpoint-api.hashicorp.com/v1/check/terraform |
    sed -n 's/.*"current_version":"\([^"]*\)".*/\1/p')
fi

base="https://releases.hashicorp.com/terraform/${VERSION}"
asset="terraform_${VERSION}_linux_${ARCH}.zip"
sums="terraform_${VERSION}_SHA256SUMS"

workdir="$(mktemp -d)"
GNUPGHOME="$(mktemp -d)"
export GNUPGHOME
trap 'rm -rf "$workdir" "$GNUPGHOME"' EXIT

curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 --retry-all-errors \
  "${base}/${asset}" -o "${workdir}/${asset}"
