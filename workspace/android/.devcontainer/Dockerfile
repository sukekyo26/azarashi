    chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.android /home/${USERNAME}/.claude /home/${USERNAME}/.codex /home/${USERNAME}/.config /home/${USERNAME}/.copilot /home/${USERNAME}/.flutter /home/${USERNAME}/.gradle /home/${USERNAME}/.npm /home/${USERNAME}/.npm-global /home/${USERNAME}/.pub-cache
